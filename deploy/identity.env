# The identity service's settings, installed as /etc/identity/identity.env
# (root:identity 0640) and read by identity.service. Nothing here is a secret:
# the database password is /etc/identity/db-password, root-owned 0600, which
# systemd hands the service as a credential. A changed value takes a restart.
IDENTITY_LISTEN=127.0.0.1:9082
# A JSON file holding the accounts in place of PostgreSQL, for a deployment too
# small for a database: /var/lib/identity/store.json, under the unit's state
# directory. Set, the database settings below are ignored and the unit needs the
# drop-in deploy/README.md shows. Empty, the service uses PostgreSQL.
IDENTITY_STORE_FILE=
# The listener the router asks which account a token names; the forward never reaches it.
IDENTITY_INTROSPECT_LISTEN=127.0.0.1:9083
# The jail's PostgreSQL over the host's internal network, verified against
# IDENTITY_DB_CA_FILE: the jail's own certificate, or the issuer that signed it.
# The URL names no password and no sslmode weaker than verify-full.
IDENTITY_DB_URL=postgres://identity@<jail-address>:5432/identity?sslmode=verify-full
IDENTITY_DB_CA_FILE=/etc/identity/db-ca.crt
IDENTITY_DB_POOL=10
# Accounts at which registration closes; 0 leaves no cap.
IDENTITY_MAX_ACCOUNTS=0
# The header the router forwards the player's address in, believed from a
# loopback peer alone; per-address budgets count what it names.
IDENTITY_CLIENT_ADDRESS_HEADER=X-Real-IP
IDENTITY_LOG_LEVEL=info
